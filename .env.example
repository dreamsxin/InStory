# Server
PORT=4000
HOST=0.0.0.0
SQLITE_DATABASE_PATH=data/instory.sqlite

# Admin console credential. Leaving this empty makes every /api/admin route
# unauthenticated, which is only tolerated when NODE_ENV != production; the server
# refuses to boot in production without a random value of at least 32 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never expose this as NEXT_PUBLIC_*: Next.js would inline it into the browser bundle.
ADMIN_TOKEN=dev-admin-token

# Accounts and identity
# Owner-scoped routes (/api/me/*, /api/reader/profiles, reading sessions) resolve the
# caller from a Bearer token or the instory_session cookie. Because sign-in is not
# wired into the web client yet, non-production servers fall back to the seeded
# legacy reader so local development keeps working. Production never does: it
# requires a real session, and unauthenticated calls get 401.
#
# Register the first account with:
#   curl -X POST http://localhost:4000/api/auth/register \
#     -H 'content-type: application/json' \
#     -d '{"email":"you@example.com","displayName":"你的昵称","password":"至少八位密码"}'
#
# Admin access is granted either by ADMIN_TOKEN or by a user whose role is 'admin'
# (promote one with: UPDATE users SET role = 'admin' WHERE email_normalized = '...').

# AI provider
# Use mock for local development without API keys.
LLM_PROVIDER=mock

# Mock provider only: pause between streamed pieces, in milliseconds. At 0 the mock
# finishes within a frame, so the reader's "writing..." state never becomes visible.
# The end-to-end suite sets this so the streaming UI is actually exercised.
# MOCK_STREAM_CHUNK_DELAY_MS=60


# Use an OpenAI-compatible chat completions endpoint when needed.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=replace-with-your-key
# LLM_MODEL=gpt-4.1-mini
# LLM_TIMEOUT_MS=45000

# Retries. Transient upstream faults (429, 5xx, transport errors) and replies that
# fail schema validation are retried with exponential backoff. A bad key or unknown
# model is not retried, since a second identical call fails the same way and still
# costs quota. Streaming only retries before the first text reaches the reader.
# LLM_MAX_ATTEMPTS=3
# LLM_RETRY_BASE_DELAY_MS=500

# Per-million-token prices used to derive cost in the admin console. Leave unset and
# cost is reported as unknown rather than as a misleading zero. Token counts are
# recorded either way.
# LLM_PRICE_INPUT_PER_MTOK=0.4
# LLM_PRICE_OUTPUT_PER_MTOK=1.6

# Successful generations allowed per reader per UTC day. Failed attempts are recorded
# but do not consume quota.
DAILY_TURN_QUOTA=20

# Turns GET /api/sessions/:id returns when the caller does not ask for a count. A long
# story is otherwise a growing tax on every page view: the whole transcript is read,
# parsed and shipped to the browser. Readers walk further back through
# GET /api/sessions/:id/turns?before=<turnId>. Callers may request up to 200.
# SESSION_TURN_WINDOW=40


# Abuse limits: 10 sign-in or sign-up attempts per address per minute, 5 failed
# sign-ins per account per 15 minutes, and 6 turn generations per reader per minute.
# Override any of them below. Counters live in the process, so a multi-instance
# deployment needs a shared store before treating them as a hard ceiling.
# AUTH_ATTEMPTS_PER_MINUTE=10
# LOGIN_FAILURES_PER_ACCOUNT=5
# GENERATION_BURST_PER_MINUTE=6
#
# Per-address limits need the real client address. Behind a reverse proxy every request
# appears to come from the proxy, which would put all readers in one bucket, so set
# TRUST_PROXY to the number of proxy hops or to a comma-separated list of trusted
# addresses/CIDRs. Leave it unset when nothing trusted is in front: X-Forwarded-For is
# client-controlled and would otherwise let a caller forge its address.
# TRUST_PROXY=1

# Web
NEXT_PUBLIC_API_BASE=http://localhost:4000

# The browser talks to /api on the web origin and Next proxies it to the API (see the
# rewrite in apps/web/next.config.ts). That keeps requests same-origin, which is what
# lets the session cookie be sent at all. Set this when the API is not at the address
# above, for example inside Docker where it is reachable by service name.
# API_PROXY_TARGET=http://server:4000

