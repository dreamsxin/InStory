# Server
PORT=4000
HOST=0.0.0.0
SQLITE_DATABASE_PATH=data/instory.sqlite

# Admin console credential. Leaving this empty makes every /api/admin route
# unauthenticated, which is only tolerated when NODE_ENV != production; the server
# refuses to boot in production without a random value of at least 32 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never expose this as NEXT_PUBLIC_*: Next.js would inline it into the browser bundle.
ADMIN_TOKEN=dev-admin-token

# Accounts and identity
# Owner-scoped routes (/api/me/*, /api/reader/profiles, reading sessions) resolve the
# caller from a Bearer token or the instory_session cookie. Because sign-in is not
# wired into the web client yet, non-production servers fall back to the seeded
# legacy reader so local development keeps working. Production never does: it
# requires a real session, and unauthenticated calls get 401.
#
# Register the first account with:
#   curl -X POST http://localhost:4000/api/auth/register \
#     -H 'content-type: application/json' \
#     -d '{"email":"you@example.com","displayName":"你的昵称","password":"至少八位密码"}'
#
# Admin access is granted either by ADMIN_TOKEN or by a user whose role is 'admin'
# (promote one with: UPDATE users SET role = 'admin' WHERE email_normalized = '...').

# AI provider
# Use mock for local development without API keys.
LLM_PROVIDER=mock

# Use an OpenAI-compatible chat completions endpoint when needed.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=replace-with-your-key
# LLM_MODEL=gpt-4.1-mini
# LLM_TIMEOUT_MS=45000

# Web
NEXT_PUBLIC_API_BASE=http://localhost:4000
